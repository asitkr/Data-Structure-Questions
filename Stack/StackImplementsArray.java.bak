import java.util.*;

class StackImplementsArray
{
	int capacity;
	int[] arr;
	int top;

	StackImplementsArray(int capacity){
		this.capacity = capacity;
		top = -1;
		arr = new int[this.capacity];
	}

	void push(int data){
		if(top == capacity-1){
			System.out.println("Over flow");
		}
		top++;
		arr[top] = data;
	}

	int pop(){
		if(top == -1){
			System.out.println("Under flow");
		}
		int res = arr[top];
		top--;
		return res;
	}

	int peek(){
		if(top == -1){
			System.out.println("Under flow");
		}
		return arr[top];
	}

	boolean isEmpty(){
		return top == -1;
	}

	public static void main(String[] args) 
	{
		StackImplementsArray sia = new StackImplementsArray(4);
		Stack<Integer> st = new Stack<>();
		//sia.pop();
		//System.out.println(sia.pop());
		System.out.println(sia.isEmpty());
		sia.push(10);
		sia.push(20);
		sia.push(30);
		System.out.println(sia.peek());
		System.out.println(sia.pop());
		System.out.println(sia.isEmpty());
		//printStack(st);
	}

	/*public static void printStack(Stack<Integer> s){
		if(s.isEmpty()){
			return;
		}

		int x = s.peek();
		s.pop();

		System.out.print(x + " ");
		System.out.println();

		printStack(s);

		s.push(x);
	}*/
}
