import java.util.*;

class Node
{
	int x;
	Node next;
	Node(int x){
		this.x = x;
		this.next = null;
	}
}

class DeleteNodeLinkListAtLastPlace 
{
	public static void main(String[] args) 
	{
		Scanner sc = new Scanner(System.in);
		int n = sc.nextInt();

		Node head = null;
		Node temp = null;

		for(int i=0; i<n; i++){
			int x = sc.nextInt();
			Node newNode = new Node(x);

			if(head == null){
				head = newNode;
				temp = head;
			}
			else{
				temp.next = newNode;
				temp = temp.next;
			}
		}
		
		printList(head);
		//System.out.println("Hello World!");
		deleteFromLast(head);
		printList(head);
	}

	static void deleteFromLast(Node head){
		if(head == null){
			return;
		}
		else{
			Node temp = head;
			Node prev = null;
			while(temp.next != null){
				prev = temp;
				temp = temp.next;
			}

			temp.next = null;
		}
	}

	static void printList(Node head){
		if(head == null){
			return;
		}
		while(head != null){
			System.out.print(head.x + " " );
			head = head.next;
		}
		System.out.println();
	}
}
