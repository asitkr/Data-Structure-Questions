import java.util.*;

class Node
{
	int x;
	Node next;
	Node(int x){
		this.x = x;
		this.next = null;
	}
}

class AddNodeLinkListAtLastPlace
{
	public static void main(String[] args) 
	{
		Scanner sc = new Scanner(System.in);
		int n = sc.nextInt();

		Node head = null;
		Node temp = null;

		for(int i=0; i<n; i++){
			int x = sc.nextInt();

			if(head == null){
				head = new Node(x);
				temp = head;
			}
			else{
				temp.next = new Node(x);
				temp = temp.next;
			}
		}

		printList(head);
		addAtLastPosition(head, 999);
		printList(head);
	}

	static void addAtLastPosition(Node head, int k){
		Node temp = head;
		if(temp == null){
			head = new Node(k);
		}
		else{
			while(head != null){
				temp = temp.next;
			}

			temp.next = new Node(k);
		}
	}

	static void printList(Node head){
		if(head == null)
		{
			return;
		}
		while(head != null){
			System.out.print(head.x + " " );
			head = head.next;
		}
		System.out.println();
	}
}
