import java.util.*;

class WordBreak 
{
	public static void main(String[] args) 
	{
		String[] arr = {"cookies", "cookie", "and", "send", "cream"};
        String s = "cookiesandcream";

		HashSet<String> st = new HashSet<>();

		for(int i=0; i<arr.length; i++){
			st.add(arr[i]);
		}

		System.out.println(wordBreak(s, st));
	}

	public static boolean wordBreak(String s, HashSet<String> st){
		
		
		for(int i=1; i<=s.length(); i++){
			String left = s.substring(0, i);

			if(st.contains(left) && wordBreak(s.substring(i), st)){
				return true;
			}
		}

		return false;
	}
}
