class MergeTwoSortedArrayWithoutUsingSpace
{
	public static void main(String[] args) 
	{
		int[] arr = {2, 5, 7, 10, 27, 50};
		int[] brr = {8, 16, 20, 34, 90};

		int i=0;
		int j=0;

		while(i < arr.length && j < brr.length){
			if(arr[i] < brr[j]){
				System.out.print(arr[i] + " ");
				i++;
			}
			else{
				System.out.print(brr[j] + " ");
				j++;
			}
		}

		while(i < arr.length){
			System.out.print(arr[i] + " ");
			i++;
		}

		while(j < brr.length){
			System.out.print(brr[j] + " ");
			j++;
		}

		System.out.println();
	}
}
