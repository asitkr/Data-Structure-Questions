class FindUniqueQuardpalArray
{
	public static void main(String[] args) 
	{
		
		int[] arr = {1, 2, -3, 4, -2, -1, 3};
		int sum = 3;
		int n = arr.length-1;

		for(int i=0; i<n-3; i++){
			for(int j=i+1; j<n-2; j++){
				for(int k=j+1; k<n-1; k++){
					for(int l=k+1; l<n; l++){
						if(arr[i] + arr[j] + arr[k] + arr[l] == sum) {
							System.out.print(arr[i] + " " + arr[j] + " " + arr[k] + " " + arr[l]);
							System.out.println();
						}
					}
				}
			}
		}
	}
}
