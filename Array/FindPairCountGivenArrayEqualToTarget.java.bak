import java.util.*;

class FindPairCountGivenArrayEqualToTarget 
{
	public static void main(String[] args) 
	{
		int[] arr = {-1, -5, 9, -3, 0, 6, 7, 2, 8, 5, 4, 1};
		int n = 6;

		//-1, 7
		//9, 3
		//0, 6
		//2, 8
		//5, 1

		Map<Integer, Integer> map = new HashMap<>();

		for(int i=0; i<arr.length; i++){
			map.put(arr[i], i);
		}

		int count = 0;
		for(int i=0; i<arr.length; i++){
			int k = n - arr[i];
			if(map.containsKey(k)){
				count++;
				map.remove(arr[i]);
			}
		}

		System.out.println(count);
	}
}
