import java.util.*;

class LongestSubSquenceArray 
{
	public static void main(String[] args) 
	{
		int[] arr = {4, 1, 7, 2, 3, 8};

		System.out.println(findMaxSubSequence(arr));
	}

	public static int findMaxSubSequence(int[] arr){
		int n = arr.length;

		Set<Integer> st = new HashSet<>();

		int longest = 0;
		for(int i=0; i<n; i++){
			if(!st.contains(arr[i]-1)){
				int num = arr[i] + 1;

				while(st.contains(num)){
					num++;
				}

				longest = Math.max(longest, num - arr[i]);
			}
		}

		return longest;
	}
}
