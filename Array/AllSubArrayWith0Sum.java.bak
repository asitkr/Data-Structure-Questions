import java.util.*;

class AllSubArrayWith0Sum 
{
	public static void main(String[] args) 
	{
		int[] arr = {6, 3, -1, -3, 4, -2, 2, 4, 6, -12, -7};
		int n = arr.length;

		findSubArrays(arr, n);
	}

	public static void findSubArrays(int[] arr, int n){
		Map<Integer, ArrayList<Integer>> map = new HashMap<>();
		int sum = 0;
		int count = 0;

		for(int i=0; i<n; i++){
			sum += arr[i];

			if(sum == 0){
				printList(arr, 0, i);
				count++;
			}

			ArrayList<Integer> list = new ArrayList<>();

			int k = 0;

			if(map.containsKey(sum)){
				list = map.get(sum);

				for(int j=0; j<list.size(); j++){
					printList(arr, list.get(j)+1, i);
					count++;
				} 
			}
			list.add(i);
			map.put(sum, list);
		}
		System.out.println("Total Number of SubArrays " + count);
	}

	public static void printList(int[] arr, int start, int end){
		for(int i=start; i<=end; i++){
			System.out.print(arr[i] + " " );
		}
		System.out.println();
	}
}
